+static int smb_psy_notifier_call(struct notifier_block *nb,
+				 unsigned long event, void *data)
+{
+	struct smb_chip *chip = container_of(nb, struct smb_chip, psy_nb);
+	struct power_supply *psy = data;
+
+	if (event == PSY_EVENT_PROP_CHANGED && psy == chip->tcpm_psy)
+		mod_delayed_work(system_wq, &chip->status_change_work, 0);
+
+	return NOTIFY_OK;
 }
 
+static void smb_unregister_psy_notifier(void *data)
+{
+	struct smb_chip *chip = data;
+
+	power_supply_unreg_notifier(&chip->psy_nb);
+}
