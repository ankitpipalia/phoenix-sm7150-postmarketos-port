From 58c065933c243672f81b2ec694ac2cdc0829c39d Mon Sep 17 00:00:00 2001
From: OpenAI Codex <codex@openai.com>
Date: Fri, 21 Aug 2026 00:05:59 +0000
Subject: [PATCH 9/9] arm64: dts: qcom: sm7150-xiaomi: wire charger to TCPM

Allow the PM6150 charger driver to consult the local TCPM power supply when
BC1.2 APSD does not complete.

Signed-off-by: OpenAI Codex <codex@openai.com>
---
 arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi
index dbe7eb4a2..f2ed9949c 100644
--- a/arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7150-xiaomi-common.dtsi
@@ -576,6 +576,7 @@ &mdss_dsi0_phy {
 
 &pm6150_charger {
 	monitored-battery = <&battery>;
+	qcom,tcpm-source = <&pm6150_typec>;
 	status = "okay";
 };
 
-- 
2.54.0
