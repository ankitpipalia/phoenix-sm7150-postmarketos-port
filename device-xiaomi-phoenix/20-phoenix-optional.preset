# Phoenix images from this project are headless-server installations.  Keep
# policy-sensitive battery helpers opt-in, but always disable the graphical
# greeter and enable the panel blanker and cold-boot dock recovery.
disable greetd.service
enable phoenix-screen-off.service
enable phoenix-usb-host-wake.service
enable phoenix-llm-manager.service

# Preserve administrator opt-in state for the remaining optional helpers.
ignore phoenix-charge-cap.timer
ignore phoenix-battery-safety.service
ignore phoenix-battery-telemetry.service
ignore phoenix-typec-recover.timer
