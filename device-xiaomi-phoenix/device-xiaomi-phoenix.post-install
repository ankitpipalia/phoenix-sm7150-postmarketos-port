#!/bin/sh
set -e

# msm-modem-uim-selection fails when modem firmware is unavailable and its
# RequiredBy= relationship drags ModemManager down with it.
rm -f /etc/systemd/system/ModemManager.service.requires/msm-modem-uim-selection.service

# Keep this unit masked by default; unmask manually once modem bring-up is done.
mkdir -p /etc/systemd/system
ln -sf /dev/null /etc/systemd/system/msm-modem-uim-selection.service

# Phoenix boots through U-Boot/systemd-boot and does not expose Android A/B
# slots. qbootctl otherwise fails every boot with "No slots found" and leaves
# the system in a misleading degraded state.
ln -sf /dev/null /etc/systemd/system/qbootctl.service

# No Phoenix IIO sensor drivers are available yet. The statically activated
# proxy otherwise spins for minutes, fails its shutdown timeout, and leaves the
# boot degraded. Remove this mask when the sensor drivers are enabled.
ln -sf /dev/null /etc/systemd/system/iio-sensor-proxy.service

if command -v systemctl >/dev/null 2>&1; then
	# Pick up the /dev/null mask above and any unit-file changes shipped
	# by this upgrade. Without daemon-reload, masking is a no-op until
	# next boot when run against a live (non-chroot) system.
	systemctl daemon-reload >/dev/null 2>&1 || true
	# Make sure the [Install] wants-symlinks reflect the current unit
	# file. systemctl start would race with the service ordering against
	# NetworkManager (Before=) so we skip it; the unit fires at next
	# boot. Direct invocation here would race the systemd-started copy.
	systemctl reenable phoenix-wlan-mac.service >/dev/null 2>&1 || true
	# This port is deployed as an SSH-managed server: no graphical greeter,
	# panel off, and automatic recovery of an attached USB-C Ethernet dock.
	systemctl set-default multi-user.target >/dev/null 2>&1 || true
	systemctl disable --now greetd.service >/dev/null 2>&1 || true
	systemctl enable --now phoenix-screen-off.service >/dev/null 2>&1 || true
	systemctl enable phoenix-usb-host-wake.service >/dev/null 2>&1 || true
	systemctl enable --now phoenix-llm-manager.service >/dev/null 2>&1 || true
fi

# Compile dconf defaults so notification policy is active after install.
if command -v dconf >/dev/null 2>&1; then
	dconf update >/dev/null 2>&1 || true
fi
