[Unit]
Description=Watch for eth0 to appear under /sys/class/net (USB-Ethernet hub)

[Path]
# Fires the .service when /sys/class/net/eth0 starts existing OR when the
# system is started with it already existing. Idempotent — the .service
# is itself a no-op if eth0 is already connected.
PathExists=/sys/class/net/eth0

[Install]
WantedBy=multi-user.target
