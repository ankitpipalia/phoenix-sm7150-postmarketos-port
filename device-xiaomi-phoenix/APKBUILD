	make-dynpart-mappings
	networkmanager
	bluez
	polkit-elogind
	postmarketos-base
	rmtfs
	rmtfs-systemd
	soc-qcom
	systemd-boot
	unl0kr-fbforcerefresh
"
makedepends="devicepkg-dev"
install="
	$pkgname.post-install
	$pkgname.post-upgrade
"
source="
	00-phoenix-notification-policy
	00-phoenix-notification-policy.lock
	20-phoenix-optional.preset
	52_phoenix_eth_trust.nft
	90-phoenix-mac.conf
	90-phoenix-wlan-mac.preset
	adsp-disable-recovery.service
	dconf-profile-user
	phoenix-wlan-mac.service
	phoenix-wlan-mac.sh
	$pkgname.post-install
