	extra-addon/phoenix-charge-cap.conf
	extra-addon/phoenix-charge-cap-reset.service
	extra-addon/phoenix-charge-cap.service
	extra-addon/phoenix-charge-cap.sh
	extra-addon/phoenix-charge-cap.timer
	extra-addon/phoenix-battery-report.sh
	extra-addon/phoenix-battery-safety.conf
	extra-addon/phoenix-battery-safety.service
